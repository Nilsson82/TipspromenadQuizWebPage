{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tipspromenad:schema:question-bank:1",
  "title": "Tipspromenad multilingual question bank, version 1 (design draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "names", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "type": "string", "minLength": 1 },
    "names": { "$ref": "#/$defs/localizedText" },
    "descriptions": { "$ref": "#/$defs/localizedText" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "names"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "names": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "language": { "enum": ["en", "es", "sv", "da", "no", "fi"] },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/language" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answers"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "answers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "unlockRadiusMetres"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "unlockRadiusMetres": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "publicQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "translations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/id" },
        "difficulty": { "enum": ["easy", "medium", "hard", "unspecified"] },
        "audience": {
          "oneOf": [
            { "enum": ["all", "children", "adults", "family", "unspecified"] },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["all", "children", "adults", "family", "unspecified"] } }
          ]
        },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "correctAnswerId": { "$ref": "#/$defs/id" },
        "translations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": { "$ref": "#/$defs/translation" }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "alt"],
          "properties": {
            "url": { "type": "string", "format": "uri-reference" },
            "alt": { "$ref": "#/$defs/localizedText" },
            "credit": { "type": "string" },
            "license": { "type": "string" }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "title": { "type": "string", "minLength": 1 },
              "accessedAt": { "type": "string", "format": "date" }
            }
          }
        },
        "verifiedAt": { "type": "string", "format": "date" },
        "gps": { "$ref": "#/$defs/station" },
        "legacyOrigin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "file", "questionIndex", "sourceSha256"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "file": { "type": "string", "minLength": 1 },
            "listIndex": { "type": "integer", "minimum": 0 },
            "questionIndex": { "type": "integer", "minimum": 0 },
            "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "question": {
      "allOf": [
        { "$ref": "#/$defs/publicQuestion" },
        { "required": ["correctAnswerId"] }
      ]
    }
  }
}
